{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nithinreddy3093-pixel-perfect-replica",
  "main": ".output-publish/server/index.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output-publish/public"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
